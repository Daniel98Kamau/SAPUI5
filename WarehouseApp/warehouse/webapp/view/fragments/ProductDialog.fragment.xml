<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="idProductDialog" title="Quick Edit: {products>/Name}">
        <content>
            <VBox id="vbox" class="sapUiSmallMargin">
                <Label id="label" text="Adjust Price" />
                <StepInput id="stepInput" value="{products>/Price}" step="5" />
            </VBox>
        </content>
        <beginButton>
            <Button id="closeButton" text="Close" press=".onCloseDialog" type="Transparent" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>