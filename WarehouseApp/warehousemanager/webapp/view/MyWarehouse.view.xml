<mvc:View controllerName="warehousemanager.controller.MyWarehouse"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    displayBlock="true">

    <Page id="page" title="{i18n>title}">
        <content>
            <ObjectHeader
                id="productHeader"
                title="{products>/Name}"
                number="{products>/Price}"
                numberUnit="{products>/Currency}">
                <statuses>
                    <ObjectStatus
                        id="stockStatus"
                        text="{products>/StockStatus}" 
                        state="{= ${products>/StockStatus} === 'Critical' ? 'Error' : 'Success' }" />
                </statuses>
            </ObjectHeader>
            
            <Input 
                id="idPriceInput" 
                value="{products>/Price}" 
                description="{products>/Currency}"
                valueLiveUpdate="true" 
                width="200px" />
        </content>
    </Page>
</mvc:View>